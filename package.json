{
	"name": "enhancer",
	"module": "src/content/index.ts",
	"type": "module",
	"version": "5.1.20",
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@preact/preset-vite": "^2.10.2",
		"@types/chrome": "^0.0.262",
		"@types/signale": "^1.4.7",
		"@types/styled-components": "^5.1.34",
		"bun-types": "^1.2.16",
		"concurrently": "^9.1.2",
		"husky": "^9.1.7",
		"jszip": "^3.10.1",
		"vite": "^7.1.11",
		"vite-plugin-generate-file": "^0.3.1",
		"vite-tsconfig-paths": "^5.1.4"
	},
	"peerDependencies": {
		"typescript": "^5.3.3"
	},
	"dependencies": {
		"@preact/compat": "^18.3.1",
		"@preact/signals": "^2.2.0",
		"graphql-tag": "^2.12.6",
		"nanoevents": "^9.1.0",
		"preact": "^10.26.9",
		"preact-hooks": "^0.0.0-0.0.0",
		"styled-components": "^6.1.19"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"typecheck:watch": "tsc --noEmit --watch",
		"lint": "bun run biome:check",
		"biome:check": "biome check --write .",
		"biome:check-staged": "biome check --write --staged",
		"biome:format": "biome format --write .",
		"biome:ci": "biome check .",
		"biome:watch": "biome check --watch .",
		"dev": "ENVIRONMENT=development concurrently \"bun run biome:check\" \"bun run typecheck:watch\" \"vite build --watch\" \"vite\"",
		"build": "ENVIRONMENT=production bun run biome:ci && bun run typecheck && vite build",
		"pack": "bun run scripts/pack.ts",
		"prepare": "husky"
	},
	"trustedDependencies": ["@biomejs/biome", "esbuild"]
}
